{
  "info": {
    "_postman_id": "c4d5e6f7-a1b2-4c3d-8e9f-0123456789ab",
    "name": "SOA - Bài Thực Hành Số 4: Order Management Service",
    "description": "Bộ sưu tập kiểm thử RESTful API Dịch vụ Quản lý Đơn hàng (Port 8002) với CSDL riêng, kiểm tra tồn kho từ Product Service (Port 8001) và xác thực qua Auth Service (Port 8000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "auth_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "product_url",
      "value": "http://localhost:8001",
      "type": "string"
    },
    {
      "key": "order_url",
      "value": "http://localhost:8002",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "created_order_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Xác thực qua Auth Service (Port 8000)",
      "item": [
        {
          "name": "1.1 Đăng nhập lấy Token (POST /login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Đăng nhập thành công 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.access_token);",
                  "    console.log(\"Đã lưu token:\", jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"userName\": \"student\",\n    \"password\": \"MTIzNDU2\"\n}"
            },
            "url": {
              "raw": "{{auth_url}}/login",
              "host": ["{{auth_url}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "1.2 Kiểm tra Token với Auth Service (GET /auth)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{auth_url}}/auth",
              "host": ["{{auth_url}}"],
              "path": ["auth"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Kiểm tra tồn kho tại Product Service (Port 8001)",
      "item": [
        {
          "name": "2.1 Lấy danh sách sản phẩm & số lượng tồn kho (GET /products)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{product_url}}/products",
              "host": ["{{product_url}}"],
              "path": ["products"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Order Service CRUD & Stock Control (Port 8002)",
      "item": [
        {
          "name": "3.1 Lấy danh sách đơn hàng (GET /orders)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{order_url}}/orders",
              "host": ["{{order_url}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "3.2 Tạo đơn hàng mới (POST /orders - Tự động trừ tồn kho)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Tạo đơn thành công 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set(\"created_order_id\", jsonData.data.id.toString());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"product_id\": 1,\n    \"quantity\": 1,\n    \"receiver_name\": \"Nguyễn Văn A\",\n    \"receiver_phone\": \"0901234567\",\n    \"shipping_address\": \"123 Lê Lợi, Q1, TP.HCM\",\n    \"notes\": \"Giao giờ hành chính\"\n}"
            },
            "url": {
              "raw": "{{order_url}}/orders",
              "host": ["{{order_url}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "3.3 Xem chi tiết đơn hàng (GET /orders/:id)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{order_url}}/orders/{{created_order_id}}",
              "host": ["{{order_url}}"],
              "path": ["orders", "{{created_order_id}}"]
            }
          }
        },
        {
          "name": "3.4 Cập nhật trạng thái đơn hàng (PUT /orders/:id)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"confirmed\"\n}"
            },
            "url": {
              "raw": "{{order_url}}/orders/{{created_order_id}}",
              "host": ["{{order_url}}"],
              "path": ["orders", "{{created_order_id}}"]
            }
          }
        },
        {
          "name": "3.5 Hủy đơn hàng (PUT /orders/:id - Tự hoàn tồn kho)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"cancelled\"\n}"
            },
            "url": {
              "raw": "{{order_url}}/orders/{{created_order_id}}",
              "host": ["{{order_url}}"],
              "path": ["orders", "{{created_order_id}}"]
            }
          }
        },
        {
          "name": "3.6 Xóa đơn hàng (DELETE /orders/:id)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{order_url}}/orders/{{created_order_id}}",
              "host": ["{{order_url}}"],
              "path": ["orders", "{{created_order_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Kiểm thử các trường hợp lỗi (Error Cases)",
      "item": [
        {
          "name": "4.1 Không có Token (401 Unauthorized)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{order_url}}/orders",
              "host": ["{{order_url}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "4.2 Đặt mua vượt quá số lượng tồn kho (422 Unprocessable)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"product_id\": 1,\n    \"quantity\": 999999\n}"
            },
            "url": {
              "raw": "{{order_url}}/orders",
              "host": ["{{order_url}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "4.3 Đặt mua sản phẩm không tồn tại (404 Not Found)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"product_id\": 999999,\n    \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{order_url}}/orders",
              "host": ["{{order_url}}"],
              "path": ["orders"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Health Check (GET /health)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{order_url}}/health",
          "host": ["{{order_url}}"],
          "path": ["health"]
        }
      }
    }
  ]
}
