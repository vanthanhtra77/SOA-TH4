APP_NAME="Order Service - TH4"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002
APP_TIMEZONE=Asia/Ho_Chi_Minh

LOG_CHANNEL=stack
LOG_SLACK_WEBHOOK_URL=

# Cơ sở dữ liệu riêng của Order Service (Kiến trúc SOA - Database per Service)
DB_CONNECTION=sqlite
DB_DATABASE=database/orders.sqlite

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Tích hợp liên dịch vụ (Inter-Service Communication)
AUTH_SERVICE_URL=http://127.0.0.1:8000/auth
AUTH_SERVICE_TIMEOUT=5
AUTH_SERVICE_MOCK=false

PRODUCT_SERVICE_URL=http://127.0.0.1:8001/products
PRODUCT_SERVICE_TIMEOUT=5
